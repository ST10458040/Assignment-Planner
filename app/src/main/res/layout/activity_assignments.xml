<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gradient_start">

    <!-- Top premium unified app header bar -->
    <include
        layout="@layout/layout_top_app_bar"
        android:id="@+id/cl_assignments_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tactical Query Search input -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/sv_assignments"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@color/surface_container"
        app:iconifiedByDefault="false"
        app:layout_constraintTop_toBottomOf="@id/cl_assignments_header"
        app:queryHint="Search assignments, modules, codes..." />

    <!-- Filters horizontal strip list scroll views -->
    <HorizontalScrollView
        android:id="@+id/hsv_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/sv_assignments">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All (8)"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_container_high" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pending"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending (5)"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_container" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_overdue"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due Soon (2)"
                android:textColor="@color/destructive_red"
                app:chipBackgroundColor="@color/surface_container" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Gamification Streak Mini-Banner -->
    <LinearLayout
        android:id="@+id/ll_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/surface_container_low"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/hsv_filters"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_streak_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 5 Izinsuku Streak! Keep it up."
            android:textColor="@color/tertiary_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+150 XP"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dynamic operational active list content frame -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_assignments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/dock"
        app:layout_constraintTop_toBottomOf="@id/ll_streak" />

    <!-- Sticky Floating Action Trigger Bottom Button -->
    <!-- Removed for floating dock -->

    <!-- Coherent bottom navigation panel container -->
    <include
        layout="@layout/bottom_dock"
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
