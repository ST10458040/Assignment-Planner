<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_background"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_sync_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/stat_notify_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/destructive_red" />

    <TextView
        android:id="@+id/tv_sync_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Offline Mode"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_sync_icon" />

    <TextView
        android:id="@+id/tv_sync_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="3 changes waiting to sync locally"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_sync_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sync_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/accent_cyan"
        android:text="Sync Now"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_sync_subtitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dismiss_sync"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dismiss"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/btn_sync_now" />

</androidx.constraintlayout.widget.ConstraintLayout>